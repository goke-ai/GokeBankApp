@inject Goke.Bank.Web.SharedUI.Services.ThemeService ThemeService

<button class="btn btn-outline-secondary" @onclick="Toggle">
    @(ThemeService.CurrentTheme == "light" ? "🌙 Dark Mode" : "☀️ Light Mode")
</button>

@code {
    private async Task Toggle()
    {
        await ThemeService.ToggleThemeAsync();
    }
}
