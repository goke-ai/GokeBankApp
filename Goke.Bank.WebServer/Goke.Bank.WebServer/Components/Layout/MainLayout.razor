@inherits LayoutComponentBase

@inject IJSRuntime JS

<div class="page">
    <Navbar IsSidebar="false" IsDarkTheme="isDarkTheme" IsDarkThemeChanged="OnIsDarkThemeChanged" />

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isDarkTheme = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyThemeAsync();
        }
    }

    private async Task OnIsDarkThemeChanged(bool value)
    {
        if (isDarkTheme == value)
        {
            return;
        }

        isDarkTheme = value;
        await ApplyThemeAsync();
    }

    private ValueTask ApplyThemeAsync()
    {
        return JS.InvokeVoidAsync("themeManager.setTheme", isDarkTheme ? "dark" : "light");
    }
}