@inherits LayoutComponentBase

<div class="page" style="@((isSidebar == false) ? "--min-height: 100vh" : "")">
    <div class="@(isSidebar ? "sidebar" : "")">
        <Navbar IsSidebar="isSidebar"
                IsDarkTheme="isDarkTheme"
                IsDarkThemeChanged="OnIsDarkThemeChanged"
               />
    </div>

    <main>
        @if (isSidebar)
        {
            <div class="top-row px-4">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>
        }
        <article class="@(!isSidebar ? "content px-4" : "px-4")">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isSidebar = false;
    private bool isDarkTheme = true;

    private Task OnIsDarkThemeChanged(bool value)
    {
        isDarkTheme = value;
        return Task.CompletedTask;
    }
}