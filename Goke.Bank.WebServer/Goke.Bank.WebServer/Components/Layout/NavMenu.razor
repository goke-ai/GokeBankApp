@implements IDisposable

@inject NavigationManager NavigationManager

<header class="top-navbar">
    <div class="navbar-shell">
        <a class="navbar-brand" href="">Goke.Bank.WebServer</a>

        <input id="main-nav-toggle" type="checkbox" title="Navigation menu" class="navbar-toggler" />
        <label for="main-nav-toggle" class="navbar-toggler-icon">
            <span></span>
        </label>

        <div class="navbar-menu">
            <nav class="nav-links">
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                        <span>Home</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="counter">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
                        <span>Counter</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="weather">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                        <span>Weather</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="auth">
                        <span class="bi bi-lock-nav-menu" aria-hidden="true"></span>
                        <span>Auth Required</span>
                    </NavLink>
                </div>

                <AuthorizeView Roles="Administrators">
                    <Authorized>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="admin">
                                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span>
                                <span>Admin</span>
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <div class="nav-actions">
                <div class="nav-item">
                    <a class="nav-link" href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener noreferrer">
                        About
                    </a>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage">
                                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                                <span>@context.User.Identity?.Name</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link nav-button">
                                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="Account/Register">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span>
                                <span>Register</span>
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="Account/Login">
                                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                                <span>Login</span>
                            </NavLink>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}