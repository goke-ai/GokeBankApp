@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@rendermode InteractiveServer


@if (IsSidebar == true)
{
    <div class="navbar-toggler-wrapper navbar bg-body-tertiary">
        <input type="checkbox" id="navbar-toggler" checked="checked" />
        <label for="navbar-toggler" class="navbar-toggler" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </label>
    </div>
}

<nav class="navbar navbar-expand-lg bg-body-tertiary">

    <div class="container-fluid">

        <a class="navbar-brand" href="">Navbar</a>

        @if (IsSidebar == false)
        {
            <input type="checkbox" id="navbar-toggler" />
            <label for="navbar-toggler" class="navbar-toggler" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </label>
            @* <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button> *@
        }

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="counter">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="weather">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="auth">
                        <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Auth Required
                    </NavLink>
                </li>

                <AuthorizeView Roles="Administrators">
                    <Authorized>
                        <li class="nav-item dropdown">
                            <NavLink class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Admin
                            </NavLink>
                            <ul class="dropdown-menu">
                                <li>
                                    <NavLink class="dropdown-item" href="admin">
                                        <span class="bi bi-boxes-nav-menu" aria-hidden="true"></span> Dashboard
                                    </NavLink>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <NavLink class="dropdown-item" href="admin/users">
                                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Users
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item" href="admin/roles">
                                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Roles
                                    </NavLink>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="Account/Manage" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @context.User.Identity?.Name
                            </NavLink>
                            <ul class="dropdown-menu">
                                <li>
                                    <NavLink class="dropdown-item" href="Account/Manage">
                                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                                        <span>Manage</span>
                                    </NavLink>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="Account/Logout" method="post">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                        <button type="submit" class="dropdown-item nav-button">
                                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                                            <span>Logout</span>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item dropdown">
                            <NavLink class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Account
                            </NavLink>
                            <ul class="dropdown-menu">
                                <li class="nav-item">
                                    <NavLink class="dropdown-item" href="Account/Login">
                                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                                        <span>Login</span>
                                    </NavLink>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="nav-item">
                                    <NavLink class="dropdown-item" href="Account/Register">
                                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span>
                                        <span>Register</span>
                                    </NavLink>
                                </li>
                            </ul>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
            <form class="d-flex mb-2 me-0 @(IsSidebar ? "" : "mb-lg-0 me-lg-1")" role="search">
                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" />
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
            <span>@currentTheme</span>
            
            <ThemeControl IsDarkTheme="IsDarkTheme" IsDarkThemeChanged="OnIsDarkThemeChanged" />
        </div>
    </div>
</nav>

@code {
    [Parameter]
    public bool IsSidebar { get; set; } = false;
    [Parameter]
    public bool IsDarkTheme { get; set; } = false;
    [Parameter]
    public EventCallback<bool> IsDarkThemeChanged { get; set; }

    string currentTheme = "dark";
    private DotNetObjectReference<Navbar>? objRef;

    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        

    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;

        //
        objRef?.Dispose();
    }
        

    [JSInvokable]
    public async Task OnThemeChanged(string theme)
    {
        currentTheme = theme;
        IsDarkTheme = currentTheme == "dark";

        await ApplyThemeAsync();

        StateHasChanged();
    }    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // // get the current theme from local storage
            // var theme = await JS.InvokeAsync<string>("themeManager.getStorageTheme");
            // if (string.IsNullOrEmpty(theme))
            // {
            //     currentTheme = "dark";
            // }
            // else
            // {
            //     currentTheme = theme;
            // }

            // isDarkTheme = currentTheme == "dark";
            //
            // Get initial theme
            currentTheme = await JS.InvokeAsync<string>("themeManager.getSystemTheme");

            IsDarkTheme = currentTheme == "dark";

            // Register for theme change events
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("themeManager.registerThemeChangeHandler", objRef);

            //
            await ApplyThemeAsync();
        }
    }

    private async Task OnIsDarkThemeChanged(bool value)
    {
        if (IsDarkTheme == value)
        {
            return;
        }

        IsDarkTheme = value;
        currentTheme = IsDarkTheme ? "dark" : "light";

        // // set the theme in local storage
        // await JS.InvokeVoidAsync("themeManager.setStorageTheme", currentTheme);

        await ApplyThemeAsync();
    }

    private ValueTask ApplyThemeAsync()
    {
        // Call the JavaScript function to apply the theme
        return JS.InvokeVoidAsync("themeManager.setTheme", currentTheme);
    }
}