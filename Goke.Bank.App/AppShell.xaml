<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Goke.Bank.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Goke.Bank.App"
       xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
 xmlns:pages="clr-namespace:Goke.Bank.App.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="Goke.Bank.App">

    <ShellContent
        Title="Home"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Weather"
        Icon="{StaticResource IconWeather}" 
        ContentTemplate="{DataTemplate pages:WeatherPage}"
        Route="WeatherPage" />

    <ShellContent
        Title="Admin"
        Icon="{StaticResource IconWeather}" 
        ContentTemplate="{DataTemplate pages:Admin.AdminPage}"
        Route="AdminPage" />
    
    <ShellContent
        Title="Login"
        Icon="{StaticResource IconWeather}" 
        ContentTemplate="{DataTemplate pages:Account.LoginPage}"
        Route="LoginPage" />


    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
            VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
            SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
