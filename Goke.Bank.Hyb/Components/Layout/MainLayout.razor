@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <Navbar IsSidebar="true" IsDarkTheme="isDarkTheme" IsDarkThemeChanged="OnIsDarkThemeChanged" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isDarkTheme = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyThemeAsync();
        }
    }

    private async Task OnIsDarkThemeChanged(bool value)
    {
        if (isDarkTheme == value)
        {
            return;
        }

        isDarkTheme = value;
        await ApplyThemeAsync();
    }

    private ValueTask ApplyThemeAsync()
    {
        return JS.InvokeVoidAsync("themeManager.setTheme", isDarkTheme ? "dark" : "light");
    }
}